;   param=value ; assign a value to an editor property

; Star Horse Farm -- U.ZU Engine sample (B-1329): the comparison
; mini-version of the owner's Godot original. Screens are built from
; JSON specs (specs/) by ai_loop/ui_tool.gd; see README.md.

config_version=5

[application]

config/name="スターホース牧場 (U.ZU Engine sample)"
run/main_scene="res://main.tscn"
config/features=PackedStringArray("4.8")

[audio]

buses/default_bus_layout="res://default_bus_layout.tres"

[display]

window/size/viewport_width=1152
window/size/viewport_height=648

[rendering]

environment/defaults/default_clear_color=Color(0.043, 0.102, 0.063, 1)
